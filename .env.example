# =====================================================================
# Variables de entorno · copie este archivo como .env.local (desarrollo)
# y cargue los mismos valores en Vercel → Project → Settings → Environment Variables.
# NUNCA suba .env.local al repositorio.
# =====================================================================

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave publicable (sb_publishable_...) o la clave "anon" heredada. Es pública por diseño.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Clave secreta (sb_secret_...) o "service_role". SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# URL pública del sitio (sin barra final). Se usa en enlaces de correo, SEO y sitemap.
NEXT_PUBLIC_SITIO_URL=https://www.ejemplo.com

# Google Apps Script (ver apps-script/README.md)
# URL de la implementación como aplicación web (termina en /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Secreto compartido: el mismo valor en Propiedades del script → WEBHOOK_SECRET
APPS_SCRIPT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria

# Versión del texto de privacidad que acepta el paciente al reservar
CONSENTIMIENTO_VERSION=2026-11
